#!/usr/bin/env bash
#
# claude-stats - Real-time Claude Code usage dashboard
# A live terminal visualization of your Claude Code activity
#

set -euo pipefail

# Configuration
STATS_FILE="${HOME}/.claude/stats-cache.json"
REFRESH_INTERVAL="${CLAUDE_STATS_REFRESH:-1}"

# Colors (using $'...' for escape interpretation)
readonly RESET=$'\033[0m'
readonly BOLD=$'\033[1m'
readonly DIM=$'\033[2m'

readonly BLACK=$'\033[30m'
readonly RED=$'\033[31m'
readonly GREEN=$'\033[32m'
readonly YELLOW=$'\033[33m'
readonly BLUE=$'\033[34m'
readonly MAGENTA=$'\033[35m'
readonly CYAN=$'\033[36m'
readonly WHITE=$'\033[37m'

readonly BG_BLACK=$'\033[40m'
readonly BG_BLUE=$'\033[44m'
readonly BG_CYAN=$'\033[46m'
readonly BG_GREEN=$'\033[42m'
readonly BG_MAGENTA=$'\033[45m'

# Box drawing
readonly BOX_TL='╔' BOX_TR='╗' BOX_BL='╚' BOX_BR='╝'
readonly BOX_H='═' BOX_V='║'
readonly BOX_TL_S='┌' BOX_TR_S='┐' BOX_BL_S='└' BOX_BR_S='┘'
readonly BOX_H_S='─' BOX_V_S='│'

# Bar characters
readonly BAR_FULL='█' BAR_7='▇' BAR_6='▆' BAR_5='▅' BAR_4='▄' BAR_3='▃' BAR_2='▂' BAR_1='▁' BAR_EMPTY=' '

# Terminal dimensions
COLS=80
ROWS=24

get_terminal_size() {
    if command -v tput &>/dev/null; then
        COLS=$(tput cols 2>/dev/null || echo 80)
        ROWS=$(tput lines 2>/dev/null || echo 24)
    fi
    # Minimum width
    if [[ $COLS -lt 60 ]]; then COLS=60; fi
}

# Move cursor
move_to() { printf $'\033[%d;%dH' "$1" "$2"; }
clear_screen() { printf $'\033[2J\033[H'; }
hide_cursor() { printf $'\033[?25l'; }
show_cursor() { printf $'\033[?25h'; }

# Draw horizontal line
draw_hline() {
    local char="${1:-$BOX_H_S}"
    local width="${2:-$COLS}"
    printf '%*s' "$width" '' | tr ' ' "$char"
}

# Center text
center_text() {
    local text="$1"
    local width="${2:-$COLS}"
    local text_len=${#text}
    local padding=$(( (width - text_len) / 2 ))
    printf '%*s%s' "$padding" '' "$text"
}

# Format numbers with commas
format_number() {
    printf "%'d" "$1" 2>/dev/null || printf "%d" "$1"
}

# Create bar chart
make_bar() {
    local value=$1
    local max=$2
    local width=$3
    local color="${4:-$GREEN}"

    [[ $max -eq 0 ]] && max=1 || true
    local filled=$(( value * width / max ))
    [[ $filled -gt $width ]] && filled=$width || true

    printf "${color}"
    for ((i=0; i<filled; i++)); do printf "$BAR_FULL"; done
    printf "${DIM}"
    for ((i=filled; i<width; i++)); do printf "$BAR_1"; done
    printf "${RESET}"
}

# Sparkline for mini charts
make_sparkline() {
    local -a values=("$@")
    local max=1
    local chars=("$BAR_1" "$BAR_2" "$BAR_3" "$BAR_4" "$BAR_5" "$BAR_6" "$BAR_7" "$BAR_FULL")

    for v in "${values[@]}"; do
        [[ $v -gt $max ]] && max=$v || true
    done

    for v in "${values[@]}"; do
        local idx=$(( v * 7 / max ))
        [[ $idx -gt 7 ]] && idx=7 || true
        printf "${CYAN}${chars[$idx]}${RESET}"
    done
}

# Parse stats file
parse_stats() {
    if [[ ! -f "$STATS_FILE" ]]; then
        echo "Stats file not found: $STATS_FILE" >&2
        return 1
    fi

    # Read all data at once
    STATS_JSON=$(cat "$STATS_FILE")

    # Basic stats
    TOTAL_SESSIONS=$(echo "$STATS_JSON" | jq -r '.totalSessions // 0')
    TOTAL_MESSAGES=$(echo "$STATS_JSON" | jq -r '.totalMessages // 0')
    FIRST_SESSION=$(echo "$STATS_JSON" | jq -r '.firstSessionDate // ""' | cut -d'T' -f1)
    LAST_COMPUTED=$(echo "$STATS_JSON" | jq -r '.lastComputedDate // ""')

    # Longest session
    LONGEST_DURATION=$(echo "$STATS_JSON" | jq -r '.longestSession.duration // 0')
    LONGEST_MESSAGES=$(echo "$STATS_JSON" | jq -r '.longestSession.messageCount // 0')
    LONGEST_HOURS=$(echo "scale=1; $LONGEST_DURATION / 3600000" | bc)

    # Daily activity (last 14 days for display)
    DAILY_DATA=$(echo "$STATS_JSON" | jq -r '.dailyActivity | .[-14:] | .[] | "\(.date)|\(.messageCount)|\(.sessionCount)|\(.toolCallCount)"')

    # Model usage
    OPUS_OUTPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-opus-4-5-20251101"].outputTokens // 0')
    OPUS_INPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-opus-4-5-20251101"].inputTokens // 0')
    OPUS_CACHE=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-opus-4-5-20251101"].cacheReadInputTokens // 0')

    SONNET_OUTPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-sonnet-4-5-20250929"].outputTokens // 0')
    SONNET_INPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-sonnet-4-5-20250929"].inputTokens // 0')

    HAIKU_OUTPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-haiku-4-5-20251001"].outputTokens // 0')
    HAIKU_INPUT=$(echo "$STATS_JSON" | jq -r '.modelUsage["claude-haiku-4-5-20251001"].inputTokens // 0')

    # Hour counts for activity chart
    HOUR_COUNTS=$(echo "$STATS_JSON" | jq -r '.hourCounts | to_entries | sort_by(.key | tonumber) | .[] | "\(.key):\(.value)"')

    # Calculate totals
    TOTAL_OUTPUT=$((OPUS_OUTPUT + SONNET_OUTPUT + HAIKU_OUTPUT))
    TOTAL_TOOL_CALLS=$(echo "$STATS_JSON" | jq '[.dailyActivity[].toolCallCount] | add // 0')

    # Peak day
    PEAK_DAY=$(echo "$STATS_JSON" | jq -r '.dailyActivity | max_by(.messageCount) | "\(.date)|\(.messageCount)"')
    PEAK_DATE=$(echo "$PEAK_DAY" | cut -d'|' -f1)
    PEAK_MESSAGES=$(echo "$PEAK_DAY" | cut -d'|' -f2)

    # Today's stats
    TODAY=$(date +%Y-%m-%d)
    TODAY_STATS=$(echo "$STATS_JSON" | jq -r --arg today "$TODAY" '.dailyActivity[] | select(.date == $today) | "\(.messageCount)|\(.sessionCount)|\(.toolCallCount)"' 2>/dev/null || echo "0|0|0")
    TODAY_MESSAGES=$(echo "$TODAY_STATS" | cut -d'|' -f1)
    TODAY_SESSIONS=$(echo "$TODAY_STATS" | cut -d'|' -f2)
    TODAY_TOOLS=$(echo "$TODAY_STATS" | cut -d'|' -f3)
    [[ -z "$TODAY_MESSAGES" ]] && TODAY_MESSAGES=0 || true
    [[ -z "$TODAY_SESSIONS" ]] && TODAY_SESSIONS=0 || true
    [[ -z "$TODAY_TOOLS" ]] && TODAY_TOOLS=0 || true
}

draw_header() {
    local now=$(date '+%H:%M:%S')

    printf "${BG_BLUE}${WHITE}${BOLD}"
    printf "  ⚡ CLAUDE CODE STATS"
    printf '%*s' $((COLS - 35)) ''
    printf "⟳ ${now}  "
    printf "${RESET}\n"
}

draw_summary_box() {
    local box_width=$((COLS - 4))

    printf "\n"
    printf "  ${CYAN}${BOX_TL_S}$(draw_hline "$BOX_H_S" $box_width)${BOX_TR_S}${RESET}\n"

    # Row 1: Total stats
    printf "  ${CYAN}${BOX_V_S}${RESET} ${BOLD}Sessions:${RESET} ${GREEN}$(format_number $TOTAL_SESSIONS)${RESET}"
    printf "  ${BOLD}Messages:${RESET} ${GREEN}$(format_number $TOTAL_MESSAGES)${RESET}"
    printf "  ${BOLD}Tools:${RESET} ${GREEN}$(format_number $TOTAL_TOOL_CALLS)${RESET}"
    printf "  ${BOLD}Since:${RESET} ${YELLOW}${FIRST_SESSION}${RESET}"
    printf '%*s' $((box_width - 70)) ''
    printf "${CYAN}${BOX_V_S}${RESET}\n"

    # Row 2: Peak & Longest
    printf "  ${CYAN}${BOX_V_S}${RESET} ${BOLD}Peak:${RESET} ${MAGENTA}${PEAK_DATE}${RESET} ($(format_number $PEAK_MESSAGES) msgs)"
    printf "  ${BOLD}Longest:${RESET} ${MAGENTA}${LONGEST_HOURS}h${RESET} (${LONGEST_MESSAGES} msgs)"
    printf '%*s' $((box_width - 60)) ''
    printf "${CYAN}${BOX_V_S}${RESET}\n"

    printf "  ${CYAN}${BOX_BL_S}$(draw_hline "$BOX_H_S" $box_width)${BOX_BR_S}${RESET}\n"
}

draw_today_box() {
    local box_width=$((COLS - 4))

    printf "\n"
    printf "  ${YELLOW}${BOLD}▸ TODAY${RESET} ${DIM}($(date '+%b %d'))${RESET}\n"
    printf "  ${DIM}$(draw_hline "$BOX_H_S" $box_width)${RESET}\n"

    # Today's metrics with bars
    local max_today=1000
    [[ $TODAY_MESSAGES -gt $max_today ]] && max_today=$TODAY_MESSAGES || true

    printf "  ${BOLD}Messages${RESET}  "
    make_bar $TODAY_MESSAGES $max_today 30 "$GREEN"
    printf " ${WHITE}$(format_number $TODAY_MESSAGES)${RESET}\n"

    printf "  ${BOLD}Sessions${RESET}  "
    make_bar $TODAY_SESSIONS 20 30 "$BLUE"
    printf " ${WHITE}${TODAY_SESSIONS}${RESET}\n"

    printf "  ${BOLD}Tools${RESET}     "
    make_bar $TODAY_TOOLS $((max_today / 3)) 30 "$MAGENTA"
    printf " ${WHITE}$(format_number $TODAY_TOOLS)${RESET}\n"
}

draw_daily_chart() {
    local box_width=$((COLS - 4))
    local bar_width=$((COLS - 30))

    printf "\n"
    printf "  ${CYAN}${BOLD}▸ LAST 14 DAYS${RESET}\n"
    printf "  ${DIM}$(draw_hline "$BOX_H_S" $box_width)${RESET}\n"

    # Find max for scaling
    local max_msg=1
    while IFS='|' read -r date msgs sessions tools; do
        [[ $msgs -gt $max_msg ]] && max_msg=$msgs || true
    done <<< "$DAILY_DATA"

    # Draw bars
    while IFS='|' read -r date msgs sessions tools; do
        local short_date=$(echo "$date" | cut -d'-' -f2,3 | tr '-' '/')
        local bar_len=$((msgs * bar_width / max_msg))
        [[ $bar_len -lt 1 ]] && bar_len=1 || true

        # Color based on intensity
        local color="$GREEN"
        [[ $msgs -gt $((max_msg / 2)) ]] && color="$YELLOW" || true
        [[ $msgs -gt $((max_msg * 3 / 4)) ]] && color="$RED" || true

        printf "  ${DIM}%s${RESET} " "$short_date"
        printf "${color}"
        for ((i=0; i<bar_len; i++)); do printf "$BAR_FULL"; done
        printf "${RESET}"
        printf " ${DIM}%s${RESET}\n" "$(format_number $msgs)"
    done <<< "$DAILY_DATA"
}

draw_model_usage() {
    local box_width=$((COLS - 4))
    local bar_width=40

    printf "\n"
    printf "  ${MAGENTA}${BOLD}▸ MODEL USAGE${RESET} ${DIM}(output tokens)${RESET}\n"
    printf "  ${DIM}$(draw_hline "$BOX_H_S" $box_width)${RESET}\n"

    local total=$((OPUS_OUTPUT + SONNET_OUTPUT + HAIKU_OUTPUT))
    [[ $total -eq 0 ]] && total=1 || true

    # Opus
    local opus_pct=$((OPUS_OUTPUT * 100 / total))
    printf "  ${BOLD}Opus 4.5${RESET}   "
    make_bar $OPUS_OUTPUT $total $bar_width "$RED"
    printf " ${WHITE}%s${RESET} ${DIM}(%d%%)${RESET}\n" "$(format_number $OPUS_OUTPUT)" "$opus_pct"

    # Sonnet
    local sonnet_pct=$((SONNET_OUTPUT * 100 / total))
    printf "  ${BOLD}Sonnet 4.5${RESET} "
    make_bar $SONNET_OUTPUT $total $bar_width "$YELLOW"
    printf " ${WHITE}%s${RESET} ${DIM}(%d%%)${RESET}\n" "$(format_number $SONNET_OUTPUT)" "$sonnet_pct"

    # Haiku
    local haiku_pct=$((HAIKU_OUTPUT * 100 / total))
    printf "  ${BOLD}Haiku 4.5${RESET}  "
    make_bar $HAIKU_OUTPUT $total $bar_width "$GREEN"
    printf " ${WHITE}%s${RESET} ${DIM}(%d%%)${RESET}\n" "$(format_number $HAIKU_OUTPUT)" "$haiku_pct"

    # Cache stats
    local cache_gb=$(echo "scale=2; $OPUS_CACHE / 1000000000" | bc)
    printf "\n  ${DIM}Cache reads: ${cache_gb}B tokens${RESET}\n"
}

draw_hour_chart() {
    local box_width=$((COLS - 4))

    printf "\n"
    printf "  ${BLUE}${BOLD}▸ ACTIVITY BY HOUR${RESET}\n"
    printf "  ${DIM}$(draw_hline "$BOX_H_S" $box_width)${RESET}\n"

    # Build hour array
    local -a hours
    for i in {0..23}; do hours[$i]=0; done

    local max_hour=1
    while IFS=':' read -r hour count; do
        hours[$hour]=$count
        [[ $count -gt $max_hour ]] && max_hour=$count || true
    done <<< "$HOUR_COUNTS"

    # Draw sparkline style chart
    printf "  "
    for i in {0..23}; do
        local v=${hours[$i]}
        local height=$((v * 8 / max_hour))
        local chars=("$BAR_EMPTY" "$BAR_1" "$BAR_2" "$BAR_3" "$BAR_4" "$BAR_5" "$BAR_6" "$BAR_7" "$BAR_FULL")

        # Color based on time of day
        local color="$DIM"
        [[ $i -ge 9 && $i -lt 17 ]] && color="$YELLOW" || true   # Work hours
        [[ $i -ge 17 && $i -lt 22 ]] && color="$GREEN" || true   # Evening
        [[ $i -ge 22 || $i -lt 2 ]] && color="$MAGENTA" || true  # Night

        printf "${color}${chars[$height]}${RESET}"
    done
    printf "\n"

    # Hour labels
    printf "  ${DIM}"
    for i in 0 6 12 18 23; do
        if [[ $i -eq 0 ]]; then
            printf "0"
        elif [[ $i -eq 23 ]]; then
            printf '%*s' $((23 - 18 - 1)) ''
            printf "23"
        else
            printf '%*s' $((i - ${prev:-0} - 1)) ''
            printf "%d" "$i"
        fi
        prev=$i
    done
    printf "${RESET}\n"
}

draw_footer() {
    printf "\n"
    printf "  ${DIM}Press Ctrl+C to exit • Refresh: ${REFRESH_INTERVAL}s • Data: ~/.claude/stats-cache.json${RESET}\n"
}

render_dashboard() {
    get_terminal_size
    parse_stats

    clear_screen
    draw_header
    draw_summary_box
    draw_today_box
    draw_daily_chart
    draw_model_usage
    draw_hour_chart
    draw_footer
}

cleanup() {
    show_cursor
    clear_screen
    printf "👋 Goodbye!\n"
    exit 0
}

main() {
    # Check dependencies
    if ! command -v jq &>/dev/null; then
        echo "Error: jq is required but not installed."
        echo "Install with: brew install jq"
        exit 1
    fi

    if [[ ! -f "$STATS_FILE" ]]; then
        echo "Error: Claude Code stats file not found at $STATS_FILE"
        echo "Make sure you have Claude Code installed and have used it at least once."
        exit 1
    fi

    trap cleanup INT TERM
    hide_cursor

    while true; do
        render_dashboard
        sleep "$REFRESH_INTERVAL"
    done
}

# Handle arguments
case "${1:-}" in
    --help|-h)
        cat << 'EOF'
claude-stats - Real-time Claude Code usage dashboard

USAGE:
    claude-stats              Run the live dashboard
    claude-stats --once       Single snapshot (no refresh)
    claude-stats --help       Show this help

ENVIRONMENT:
    CLAUDE_STATS_REFRESH      Refresh interval in seconds (default: 1)

EXAMPLES:
    claude-stats                      # Default 1-second refresh
    CLAUDE_STATS_REFRESH=5 claude-stats   # 5-second refresh

EOF
        exit 0
        ;;
    --once)
        # Single shot mode - no loop, no cursor hiding
        get_terminal_size
        parse_stats
        draw_header
        draw_summary_box
        draw_today_box
        draw_daily_chart
        draw_model_usage
        draw_hour_chart
        printf "\n"
        exit 0
        ;;
    *)
        main "$@"
        ;;
esac
